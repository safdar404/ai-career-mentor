# Copy this file to .env and fill in at least one AI key. Never commit .env.
# Keep comments on their own lines: Docker Compose does not strip inline comments.

# ---- AI providers (at least one is required for coaching) ----
ANTHROPIC_API_KEY=
# OpenAI also enables voice transcription and the OpenAI voice option
OPENAI_API_KEY=
# anthropic or openai
DEFAULT_PROVIDER=anthropic

# ---- Models ----
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1

# ---- Database ----
# Leave unset to use a SQLite file in ./data (recommended for local use).
# PostgreSQL example (docker compose --profile postgres):
# DATABASE_URL=postgresql+psycopg://mentor:change-me@db:5432/mentor
POSTGRES_PASSWORD=change-me

# ---- Optional REST API (api.py). Leave empty to keep it disabled. ----
API_TOKEN=

# ---- Limits ----
LOG_LEVEL=INFO
MAX_ANSWER_CHARS=6000
LLM_TIMEOUT_SECONDS=90
